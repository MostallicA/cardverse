# CardVerse Environment Variables 
 
# Application 
NODE_ENV=development 
PORT=3000 
 
# Database 
DATABASE_URL=postgresql://user:password@localhost:5432/cardverse 
 
# JWT 
JWT_SECRET=your-super-secret-jwt-key-change-this 
JWT_EXPIRES_IN=7d 
 
# Redis 
REDIS_URL=redis://localhost:6379 
 
# Logging 
LOG_LEVEL=info 
 
# CORS 
CORS_ORIGIN=http://localhost:3001 
