// CardVerse Prisma Schema
// Follows DATABASE.md naming conventions (snake_case tables/columns, soft delete)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Represents a player account (DATABASE.md §4.1 User)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String? @map("password_hash")
  accountType  String   @default("guest") @map("account_type") // guest | google
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  // Relations
  sessions     Session[]
  matches      MatchPlayer[]
  profile      Profile?
  friends      Friend[]      @relation("user_friends")
  friendOf     Friend[]      @relation("friend_of")
  wallet       Wallet?
  inventory    Inventory[]
  achievements Achievement[]
  statistics   Statistics?
  seasons      Season[]
  notifications Notification[]

  @@map("users")
}

// Represents an active game session (DATABASE.md §4.4 Match / §4.5 Room)
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") // host user
  status    String   @default("active") // active | completed | abandoned
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user    User         @relation(fields: [userId], references: [id])
  match   Match?
  players MatchPlayer[]

  @@map("sessions")
}

// Stores match history (DATABASE.md §4.4 Match)
model Match {
  id          String    @id @default(cuid())
  sessionId   String    @unique @map("session_id")
  gameMode    String    @default("RANKED") @map("game_mode")
  status      String    @default("pending") // pending | playing | completed
  winnerTeam  Int?      @map("winner_team")
  state       Json? // Full serialized MatchState
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  session Session @relation(fields: [sessionId], references: [id])
  players MatchPlayer[]

  @@map("matches")
}

// Junction table linking players to matches (DATABASE.md §3.3 Junction Tables)
model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String  @map("match_id")
  sessionId String  @map("session_id")
  userId    String  @map("user_id")
  seatIndex Int     @map("seat_index")
  teamId    Int     @map("team_id")
  isBot     Boolean @default(false) @map("is_bot")
  isWinner  Boolean @default(false) @map("is_winner")

  match   Match   @relation(fields: [matchId], references: [id])
  session Session @relation(fields: [sessionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@map("match_players")
}

// Profile - Stores public player information (DATABASE.md ┬د4.2)
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  username    String   @unique
  avatar      String?  @default("default_avatar.png")
  avatarFrame String?  @map("avatar_frame")
  country     String?  @default("IR")
  bio         String?  @default("")
  level       Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("profiles")
}

// Friend - Stores friendship relationships (DATABASE.md ┬د4.3)
model Friend {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  friendId   String   @map("friend_id")
  status     String   @default("pending") // pending | accepted | blocked
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user   User @relation(fields: [userId], references: [id], name: "user_friends")
  friend User @relation(fields: [friendId], references: [id], name: "friend_of")

  @@unique([userId, friendId])
  @@map("friends")
}

// Wallet - Stores player currencies (DATABASE.md ┬د4.6)
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  coins     Int      @default(0)
  gems      Int      @default(0)
  lastDailyClaim  DateTime? @map("last_daily_claim")
  dailyStreak     Int      @default(0) @map("daily_streak")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User         @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("wallets")
}

// Transaction - Records wallet operations
model Transaction {
  id          String   @id @default(cuid())
  walletId    String   @map("wallet_id")
  amount      Int
  type        String   // credit | debit
  source      String   // daily_reward | shop_purchase | match_reward | admin
  description String
  balanceBefore Int   @map("balance_before")
  balanceAfter  Int   @map("balance_after")
  status      String   // pending | completed | failed
  metadata    Json?    // Additional data (JSON)
  createdAt   DateTime @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

// Inventory - Stores owned cosmetic items (DATABASE.md ┬د4.7)
model Inventory {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  itemId     String   @map("item_id")
  itemType   String   @map("item_type") // avatar | frame | card_back | theme | title
  quantity   Int      @default(1)
  isEquipped Boolean  @default(false) @map("is_equipped")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, itemId])
  @@map("inventory")
}

// Achievement - Tracks player achievements (DATABASE.md ┬د4.8)
model Achievement {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  progress      Int      @default(0)
  isUnlocked    Boolean  @default(false) @map("is_unlocked")
  unlockedAt    DateTime? @map("unlocked_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@map("achievements")
}

// Statistics - Stores permanent player statistics (DATABASE.md ┬د4.9)
model Statistics {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  totalMatches   Int      @default(0) @map("total_matches")
  wins           Int      @default(0)
  losses         Int      @default(0)
  winRate        Float    @default(0) @map("win_rate")
  disconnectRate Float    @default(0) @map("disconnect_rate")
  fairPlayScore  Int      @default(100) @map("fair_play_score")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("statistics")
}

// Season - Stores seasonal progression (DATABASE.md ┬د4.10)
model Season {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  seasonId  String   @map("season_id") // e.g., "2026-S1"
  rating    Int      @default(0)
  rank      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, seasonId])
  @@map("seasons")
}

// Notification - Stores player notifications (DATABASE.md ┬د4.11)
model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String   // friend_request | match_invite | reward | announcement
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?    // Additional data (JSON)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

// ShopItem - Items available for purchase (PRODUCT_BIBLE.md ┬د5.3)
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   // avatar | frame | card_back | theme | title
  rarity      String   // common | uncommon | rare | epic | legendary
  price       Int
  imageUrl    String?  @map("image_url")
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("shop_items")
}